{
  "name": "mlatex",
  "version": "0.1.2",
  "description": "A LaTeX typesetting engine rewritten from the ground up, compiled to WebAssembly for web pages, workers and Node.",
  "keywords": ["latex", "tex", "typesetting", "pdf", "wasm", "webassembly"],
  "homepage": "https://github.com/modern-latex/mlatex#readme",
  "bugs": "https://github.com/modern-latex/mlatex/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modern-latex/mlatex.git",
    "directory": "bindings/javascript"
  },
  "license": "AGPL-3.0-only",
  "author": "Andres Hernandez",
  "main": "node.js",
  "types": "mlatex.d.ts",
  "exports": {
    ".": {
      "types": "./mlatex.d.ts",
      "node": "./node.js",
      "default": "./mlatex.js"
    },
    "./mlatex.js": "./mlatex.js",
    "./mlatex.wasm": "./mlatex.wasm",
    "./mlatex.data": "./mlatex.data",
    "./package.json": "./package.json"
  },
  "files": ["node.js", "mlatex.js", "mlatex.wasm", "mlatex.data", "mlatex.d.ts", "LICENSING.md", "THIRD-PARTY-NOTICES.md"]

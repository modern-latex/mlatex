{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-clang",
      "displayName": "Windows (clang-cl)",
      "description": "Visual Studio 2026 Insiders Clang 22.1.3 (clang-cl): compiles C++26 and #embed. Uses the MSVC ABI, Windows SDK and vcpkg x64-windows.",
      "generator": "Ninja",
      "toolchainFile": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Insiders/VC/Tools/Llvm/x64/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Insiders/VC/Tools/Llvm/x64/bin/clang-cl.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (clang-cl)",
      "description": "A checked build with clang-cl: asserts on, no optimisation. The profile an IDE should read the code with, since cl cannot configure the project at all.",
      "inherits": "windows-clang",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (clang-cl)",
      "description": "The build that ships: optimised across the whole engine, stripped, asserts off.",
      "inherits": "windows-clang",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
